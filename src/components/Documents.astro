---
import { activeCompany } from '../config/companies';
import { documentGroups, generalNote } from '../config/documents';
---

<section id="documents" class="py-20 lg:py-28 bg-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center mb-12">
      <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">
        Документи для оцінки
      </h2>
      <p class="text-lg text-gray-600">
        Оберіть тип майна, щоб дізнатися які документи потрібно підготувати.
      </p>
    </div>

    <div class="space-y-3">
      {documentGroups.map((group) => (
        <details class="group border border-gray-200 rounded-xl overflow-hidden bg-white">
          <summary 
            class="flex items-center justify-between cursor-pointer p-5 font-semibold text-gray-900 hover:bg-gray-50 transition-colors list-none"
          >
            <span>{group.title}</span>
            <span 
              class="flex-shrink-0 w-8 h-8 rounded-full flex items-center justify-center text-white transition-transform group-open:rotate-45"
              style={`background-color: ${activeCompany.colors.primary}`}
            >
              <span class="text-xl leading-none">+</span>
            </span>
          </summary>

          <div class="px-5 pb-5 pt-1">
            <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-3">
              Обов'язкові документи:
            </p>
            <ul class="space-y-2 mb-4">
              {group.required.map((doc) => (
                <li class="flex items-start gap-2.5 text-gray-700">
                  <span 
                    class="mt-1.5 flex-shrink-0 w-1.5 h-1.5 rounded-full"
                    style={`background-color: ${activeCompany.colors.primary}`}
                  ></span>
                  <span>{doc}</span>
                </li>
              ))}
            </ul>

            {group.optional && (
              <>
                <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-3">
                  Бажано додатково:
                </p>
                <ul class="space-y-2">
                  {group.optional.map((doc) => (
                    <li class="flex items-start gap-2.5 text-gray-500">
                      <span class="mt-1.5 flex-shrink-0 w-1.5 h-1.5 rounded-full bg-gray-300"></span>
                      <span>{doc}</span>
                    </li>
                  ))}
                </ul>
              </>
            )}
          </div>
        </details>
      ))}
    </div>

    <div 
      class="mt-8 p-5 rounded-xl text-sm text-gray-700"
      style={`background-color: ${activeCompany.colors.primary}0D`}
    >
      <strong>Зверніть увагу:</strong> {generalNote}
    </div>

  </div>
</section>