---
import { activeCompany } from '../config/companies';
import { Mail, Phone, MapPin } from '@lucide/astro';

const currentYear = new Date().getFullYear();
const copyrightStartYear = activeCompany.founded || currentYear;
const copyrightRange = copyrightStartYear === currentYear
  ? `${currentYear}`
  : `${copyrightStartYear}-${currentYear}`;

const phoneClean = activeCompany.phone.replace(/[\s()-]/g, '');
const formattedIban = activeCompany.iban.match(/.{1,4}/g)?.join(' ') || activeCompany.iban;

// Колір слогана (HEX буква E з логотипу). Постав потрібний:
const sloganColor = '#79C0F2';
---

<footer class="text-white pt-10 pb-6" style={`background-color: ${activeCompany.colors.primary}`}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Верхня частина: 2 колонки -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">

      <!-- Ліва колонка: лого + контакти -->
      <div>
        <img
          src={activeCompany.logoFooter}
          alt={activeCompany.name}
          class="h-14 w-auto mb-3"
        />
        <p
          class="text-sm italic mb-5"
          style={`color: ${sloganColor}`}
        >
          {activeCompany.slogan}
        </p>

        <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
          <a href={`tel:${phoneClean}`} class="flex items-center gap-2 hover:text-white transition-colors">
            <Phone size={14} strokeWidth={1.75} />
            {activeCompany.phone}
          </a>
          <a href={`mailto:${activeCompany.email}`} class="flex items-center gap-2 hover:text-white transition-colors">
            <Mail size={14} strokeWidth={1.75} />
            {activeCompany.email}
          </a>
          <span class="flex items-center gap-2">
            <MapPin size={14} strokeWidth={1.75} />
            {activeCompany.address}
          </span>
        </div>
      </div>

      <!-- Права колонка: реквізити -->
      <div class="space-y-2 text-sm">
        <div>
          <span class="text-white/70">Повна назва:</span>{' '}
          <span class="text-white">{activeCompany.legalName}</span>
        </div>
        <div>
          <span class="text-white/70">ЄДРПОУ:</span>{' '}
          <span class="text-white font-mono">{activeCompany.edrpou}</span>
          <span class="text-white/70 mx-2">·</span>
          <span class="text-white/70">Директор:</span>{' '}
          <span class="text-white">{activeCompany.director}</span>
        </div>
        <div>
          <span class="text-white/70">Юр. адреса:</span>{' '}
          <span class="text-white">{activeCompany.legalAddress}</span>
        </div>
        <div>
          <span class="text-white/70">Банк:</span>{' '}
          <span class="text-white">{activeCompany.bank}</span>
        </div>
        <div>
          <span class="text-white/70">IBAN:</span>{' '}
          <span class="text-white font-mono text-xs">{formattedIban}</span>
        </div>
        <div>
          <span class="text-white/70">Свідоцтво СОД:</span>{' '}
          <span class="text-white">№ {activeCompany.sodNumber}</span>
          <span class="text-white/70 mx-2">·</span>
          <span class="text-white/70">Дійсне:</span>{' '}
          <span class="text-white">{activeCompany.sodIssued} — {activeCompany.sodValidUntil}</span>
        </div>
      </div>

    </div>

    <!-- Нижня смуга з copyright -->
    <div class="pt-5 border-t border-white/20 flex flex-col md:flex-row items-center justify-between gap-2 text-xs text-white/70">
      <div>
        © {copyrightRange} {activeCompany.name}. Усі права захищені.
      </div>
      <div>
        Графік роботи: {activeCompany.workingHours.weekdays}
      </div>
    </div>

  </div>
</footer>