---
import { activeCompany } from '../config/companies';

const currentYear = new Date().getFullYear();
const copyrightStartYear = activeCompany.founded || currentYear;
const copyrightRange = copyrightStartYear === currentYear 
  ? `${currentYear}` 
  : `${copyrightStartYear}-${currentYear}`;
---

<footer class="bg-gray-900 text-gray-300 py-8">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row items-center justify-between gap-4 text-sm">
      
      <div class="flex items-center gap-3">
        <img 
          src={activeCompany.logo} 
          alt={activeCompany.name}
          class="h-8 w-auto"
        />
        <span class="font-semibold text-white">{activeCompany.name}</span>
      </div>

      <div class="text-center text-gray-400">
        © {copyrightRange} {activeCompany.name}. Усі права захищені.
      </div>

      <div class="text-gray-400">
        ЄДРПОУ: <span class="font-mono">{activeCompany.edrpou}</span>
      </div>

    </div>
  </div>
</footer>