---
import { activeCompany } from '../config/companies';
import { services } from '../config/services';
import { Building2, Trees, Car, Cog, Briefcase, Lightbulb } from '@lucide/astro';

const iconMap: Record<string, any> = {
  Building2,
  Trees,
  Car,
  Cog,
  Briefcase,
  Lightbulb,
};
---

<section id="services" class="py-20 lg:py-28 xl:py-32 bg-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center mb-12 lg:mb-16 animate-on-scroll">
      <div 
        class="section-title-accent mx-auto"
        style={`background-color: ${activeCompany.colors.primary}`}
      ></div>
      <h2 class="section-title">
        Наші послуги
      </h2>
      <p class="section-subtitle">
        Проводимо незалежну оцінку будь-якого майна та майнових прав.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 animate-on-scroll delay-200">
      {services.map((service) => {
        const IconComponent = iconMap[service.icon];
        return (
          <div class="group p-7 lg:p-8 rounded-2xl border border-gray-200 bg-white hover:shadow-xl hover:-translate-y-1 transition-all duration-300 relative overflow-hidden">

            <div 
              class="absolute top-0 left-0 right-0 h-1 transform scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-left"
              style={`background-color: ${activeCompany.colors.primary}`}
            ></div>

            <div 
              class="icon-rotate w-16 h-16 lg:w-20 lg:h-20 rounded-2xl flex items-center justify-center mb-6"
              style={`background-color: ${activeCompany.colors.primary}15`}
            >
              {IconComponent && (
                <IconComponent 
                  size={36} 
                  strokeWidth={1.75}
                  color={activeCompany.colors.primary}
                />
              )}
            </div>

            <h3 class="text-xl lg:text-2xl font-bold text-gray-900 mb-2">
              {service.title}
            </h3>
            <p class="text-sm lg:text-base text-gray-600 mb-4">
              {service.description}
            </p>

            <ul class="space-y-2">
              {service.items.map((item) => (
                <li class="flex items-start gap-2.5 text-sm lg:text-base text-gray-700">
                  <span 
                    class="mt-2 flex-shrink-0 w-1.5 h-1.5 rounded-full"
                    style={`background-color: ${activeCompany.colors.primary}`}
                  ></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>

          </div>
        );
      })}
    </div>

  </div>
</section>