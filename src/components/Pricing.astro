---
import { activeCompany } from '../config/companies';
import {
  pricingSimpleItems,
  pricingTieredItems,
  pricingIntro,
  pricingCTA,
} from '../config/pricing';
import {
  KeyRound,
  House,
  Building,
  Building2,
  Landmark,
  Wheat,
  LandPlot,
  Car,
  Tractor,
  Sofa,
  Wrench,
  FileWarning,
  FileSearch,
  Lightbulb,
  Plane,
  Anchor,
  Fuel,
  TramFront,
} from '@lucide/astro';

const iconMap: Record<string, any> = {
  KeyRound,
  House,
  Building,
  Building2,
  Landmark,
  Wheat,
  LandPlot,
  Car,
  Tractor,
  Sofa,
  Wrench,
  FileWarning,
  FileSearch,
  Lightbulb,
  Plane,
  Anchor,
  Fuel,
  TramFront,
};
---

<section id="pricing" class="py-20 lg:py-28 bg-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center mb-12">
      <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">
        Вартість послуг
      </h2>
      <p class="text-lg text-gray-600">
        Прозоро і чесно про ціноутворення наших послуг.
      </p>
    </div>

    <div 
      class="mb-12 p-6 lg:p-8 rounded-2xl border-l-4"
      style={`background-color: ${activeCompany.colors.primary}0D; border-color: ${activeCompany.colors.primary}`}
    >
      <h3 class="text-xl font-bold text-gray-900 mb-4">
        {pricingIntro.title}
      </h3>
      
      {pricingIntro.paragraphs.map((p) => (
        <p class="text-gray-700 leading-relaxed mb-4">{p}</p>
      ))}

      <div class="space-y-3 mb-4">
        {pricingIntro.examples.map((ex) => (
          <div class="flex items-start gap-3">
            <span 
              class="mt-1.5 flex-shrink-0 w-2 h-2 rounded-full"
              style={`background-color: ${activeCompany.colors.primary}`}
            ></span>
            <div>
              <span class="font-semibold text-gray-900">{ex.label}</span>
              <span class="text-gray-700"> — {ex.description}</span>
            </div>
          </div>
        ))}
      </div>

      <p class="text-gray-700 leading-relaxed mb-4">
        {pricingIntro.conclusion}
      </p>

      <p class="font-semibold text-gray-900 mb-2">{pricingIntro.noteTitle}</p>
      <ul class="space-y-1 mb-4">
        {pricingIntro.noteItems.map((item) => (
          <li class="flex items-start gap-2 text-gray-700">
            <span 
              class="mt-1.5 flex-shrink-0 w-1.5 h-1.5 rounded-full"
              style={`background-color: ${activeCompany.colors.primary}`}
            ></span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
      
      <p class="text-gray-700 leading-relaxed italic">
        {pricingIntro.noteFinal}
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-8">
      {pricingSimpleItems.map((item) => {
        const IconComponent = iconMap[item.icon];
        return (
          <div class="p-5 rounded-xl border border-gray-200 bg-white hover:shadow-md transition-shadow">
            <div 
              class="w-12 h-12 rounded-lg flex items-center justify-center mb-3"
              style={`background-color: ${activeCompany.colors.primary}15`}
            >
              {IconComponent && (
                <IconComponent 
                  size={24} 
                  strokeWidth={1.75}
                  color={activeCompany.colors.primary}
                />
              )}
            </div>
            <h3 class="font-semibold text-gray-900 mb-1">{item.title}</h3>
            {item.subtitle && (
              <p class="text-sm text-gray-500 mb-3">{item.subtitle}</p>
            )}
            <p 
              class="text-lg font-bold mt-2"
              style={`color: ${activeCompany.colors.primary}`}
            >
              {item.price}
            </p>
          </div>
        );
      })}
    </div>

    <div class="space-y-4 mb-12">
      {pricingTieredItems.map((item) => {
        const IconComponent = iconMap[item.icon];
        return (
          <div class="p-6 rounded-xl border border-gray-200 bg-white">
            <div class="flex items-start gap-4 mb-4">
              <div 
                class="flex-shrink-0 w-12 h-12 rounded-lg flex items-center justify-center"
                style={`background-color: ${activeCompany.colors.primary}15`}
              >
                {IconComponent && (
                  <IconComponent 
                    size={24} 
                    strokeWidth={1.75}
                    color={activeCompany.colors.primary}
                  />
                )}
              </div>
              <div class="flex-1">
                <h3 class="text-lg font-bold text-gray-900 mb-1">{item.title}</h3>
                {item.description && (
                  <p class="text-sm text-gray-600">{item.description}</p>
                )}
              </div>
            </div>

            <div class="space-y-3 pl-0 sm:pl-16">
              {item.tiers.map((tier) => (
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 py-2 border-b border-gray-100 last:border-b-0">
                  <span class="text-gray-700 flex-1">{tier.label}</span>
                  <span 
                    class="font-bold text-base whitespace-nowrap"
                    style={`color: ${activeCompany.colors.primary}`}
                  >
                    {tier.price}
                  </span>
                </div>
              ))}
            </div>
          </div>
        );
      })}
    </div>

    <div 
      class="p-8 rounded-2xl text-center"
      style={`background-color: ${activeCompany.colors.primary}`}
    >
      <h3 class="text-2xl font-bold text-white mb-3">
        {pricingCTA.title}
      </h3>
      <p class="text-white/90 mb-3 max-w-2xl mx-auto leading-relaxed">
        {pricingCTA.description}
      </p>
      <p class="text-white/80 text-sm mb-6 max-w-2xl mx-auto italic">
        {pricingCTA.bonusNote}
      </p>
      <a href={pricingCTA.buttonHref} class="inline-block px-8 py-3 bg-white rounded-lg font-semibold hover:bg-gray-100 transition-color