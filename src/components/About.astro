---
import { activeCompany } from '../config/companies';
---

<section id="about" class="py-20 lg:py-28 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-start">

      <!-- Ліва колонка: текст -->
      <div class="animate-on-scroll">
        <div
          class="inline-block px-4 py-1.5 rounded-full text-sm font-semibold mb-6"
          style={`background-color: ${activeCompany.colors.primary}15; color: ${activeCompany.colors.primary}`}
        >
          {activeCompany.founded === 2008
            ? `На ринку з ${activeCompany.founded} року`
            : 'Сучасна оціночна компанія'}
        </div>

        <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-6">
          Про компанію
        </h2>

        <p class="text-lg text-gray-600 leading-relaxed mb-6">
          {activeCompany.about}
        </p>

        <div class="space-y-3 text-gray-700">
          <div class="flex items-start gap-3">
            <span class="font-semibold w-32 flex-shrink-0">Повна назва:</span>
            <span>{activeCompany.legalName}</span>
          </div>
          <div class="flex items-start gap-3">
            <span class="font-semibold w-32 flex-shrink-0">ЄДРПОУ:</span>
            <span>{activeCompany.edrpou}</span>
          </div>
          <div class="flex items-start gap-3">
            <span class="font-semibold w-32 flex-shrink-0">Директор:</span>
            <span>{activeCompany.director}</span>
          </div>
        </div>
      </div>

      <!-- Права колонка: сертифікати -->
      <div class="bg-white rounded-2xl border border-gray-200 p-8 lg:p-10 animate-on-scroll delay-200 hover:shadow-md transition-shadow duration-300">
        <h3 class="text-xl font-bold text-gray-900 mb-6">
          Кваліфікація та сертифікати
        </h3>
        <ul class="space-y-4">
          {activeCompany.certifications.map((cert) => (
            <li class="flex items-start gap-3">
              <span
                class="flex-shrink-0 w-6 h-6 rounded-full flex items-center justify-center text-white text-xs font-bold mt-0.5"
                style={`background-color: ${activeCompany.colors.primary}`}
              >✓</span>
              <span class="text-gray-700">{cert}</span>
            </li>
          ))}
        </ul>
      </div>

    </div>

  </div>
</section>