---
import { activeCompany } from '../config/companies';
import { faqItems } from '../config/faq';

/** Замінює плейсхолдери [phone], [email], [address] на дані компанії */
function replacePlaceholders(text: string): string {
  return text
    .replaceAll('[phone]', activeCompany.phone)
    .replaceAll('[email]', activeCompany.email)
    .replaceAll('[address]', activeCompany.address);
}
---

<section id="faq" class="py-20 lg:py-28 bg-gray-50">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center mb-12 animate-on-scroll">
      <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">
        Часті запитання
      </h2>
      <p class="text-lg text-gray-600">
        Відповіді на питання, які найчастіше цікавлять наших клієнтів.
      </p>
    </div>

    <div class="text-center mb-12 animate-on-scroll">
      {faqItems.map((item) => (
        <details class="group border border-gray-200 rounded-xl overflow-hidden bg-white">
          <summary 
            class="flex items-center justify-between cursor-pointer p-5 font-semibold text-gray-900 hover:bg-gray-50 transition-colors list-none gap-4"
          >
            <span class="flex-1">{item.question}</span>
            <span 
              class="flex-shrink-0 w-8 h-8 rounded-full flex items-center justify-center text-white transition-transform group-open:rotate-45"
              style={`background-color: ${activeCompany.colors.primary}`}
            >
              <span class="text-xl leading-none">+</span>
            </span>
          </summary>

          <div class="px-5 pb-6 pt-1 space-y-6">

            {/* Вступний текст */}
            {item.intro && (
              <div class="text-gray-700 leading-relaxed whitespace-pre-line">
                {replacePlaceholders(item.intro)}
              </div>
            )}

            {/* Секції */}
            {item.sections.map((section) => (
              <div class="space-y-3">
                <h3 
                  class="text-sm font-semibold uppercase tracking-wide" 
                  style={`color: ${activeCompany.colors.primary}`}
                >
                  {section.title}
                </h3>

                {/* Абзаци секції */}
                {section.paragraphs && section.paragraphs.map((p) => (
                  <p class="text-gray-700 leading-relaxed">
                    {replacePlaceholders(p)}
                  </p>
                ))}

                {/* Списки секції */}
                {section.lists && section.lists.map((list) => (
                  <div class="space-y-2">
                    {list.label && (
                      <p class="font-semibold text-gray-800">
                        {list.label}:
                      </p>
                    )}
                    <ul class="space-y-2">
                      {list.items.map((listItem) => (
                        <li class="flex items-start gap-2.5 text-gray-700">
                          <span 
                            class="mt-1.5 flex-shrink-0 w-1.5 h-1.5 rounded-full"
                            style={`background-color: ${activeCompany.colors.primary}`}
                          ></span>
                          <span>{replacePlaceholders(listItem)}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            ))}

          </div>
        </details>
      ))}
    </div>

  </div>
</section>