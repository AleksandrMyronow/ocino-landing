---
import { activeCompany } from '../config/companies';
import { serviceOptions, contactTexts, messengers } from '../config/contact';
import {
  Phone,
  Mail,
  MapPin,
  MessageCircle,
  Send,
  MessageSquare,
  ExternalLink,
} from '@lucide/astro';

const messengerIconMap: Record<string, any> = {
  MessageCircle,
  Send,
  MessageSquare,
};

const phoneClean = activeCompany.phone.replace(/[\s()-]/g, '');
const phoneDigits = phoneClean.replace('+', '');

const mapQuery = encodeURIComponent(activeCompany.legalAddress);
const mapEmbedUrl = `https://maps.google.com/maps?q=${mapQuery}&t=&z=17&ie=UTF8&iwloc=A&output=embed`;
const mapDirectLink = `https://www.google.com/maps/search/?api=1&query=${mapQuery}`;

const mailtoSubject = encodeURIComponent('Zayavka z saytu');
const mailtoHref = `mailto:${activeCompany.email}?subject=${mailtoSubject}`;

const messengerLinks = messengers.map((m) => {
  const href = m.id === 'telegram'
    ? `${m.hrefPrefix}${phoneClean}`
    : `${m.hrefPrefix}${phoneDigits}`;
  return { ...m, href };
});
---

<section id="contact" class="py-20 lg:py-28 xl:py-32 bg-gray-50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center mb-12 lg:mb-16 animate-on-scroll">
      <div 
        class="section-title-accent mx-auto"
        style={`background-color: ${activeCompany.colors.primary}`}
      ></div>
      <h2 class="section-title">
        {contactTexts.sectionTitle}
      </h2>
      <p class="section-subtitle">
        {contactTexts.sectionSubtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 animate-on-scroll delay-200">

      <div class="space-y-6">

        <div class="bg-white p-7 lg:p-8 rounded-2xl border border-gray-200">
          <h3 class="text-xl lg:text-2xl font-bold text-gray-900 mb-6">
            {contactTexts.contactsBlockTitle}
          </h3>

          <div class="flex items-start gap-4 mb-5">
            <div class="flex-shrink-0 w-12 h-12 lg:w-14 lg:h-14 rounded-lg flex items-center justify-center" style={`background-color: ${activeCompany.colors.primary}15`}>
              <Phone size={28} strokeWidth={1.75} color={activeCompany.colors.primary} />
            </div>
            <div>
              <p class="text-sm text-gray-500 mb-1">Телефон</p>
              <a href={`tel:${phoneClean}`} class="text-lg lg:text-xl font-semibold text-gray-900 hover:underline">
                {activeCompany.phone}
              </a>
            </div>
          </div>

          <div class="flex items-start gap-4 mb-5">
            <div class="flex-shrink-0 w-12 h-12 lg:w-14 lg:h-14 rounded-lg flex items-center justify-center" style={`background-color: ${activeCompany.colors.primary}15`}>
              <Mail size={28} strokeWidth={1.75} color={activeCompany.colors.primary} />
            </div>
            <div class="min-w-0 flex-1">
              <p class="text-sm text-gray-500 mb-1">Email</p>
              <a href={`mailto:${activeCompany.email}`} class="text-base lg:text-lg font-semibold text-gray-900 hover:underline break-all">
                {activeCompany.email}
              </a>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 w-12 h-12 lg:w-14 lg:h-14 rounded-lg flex items-center justify-center" style={`background-color: ${activeCompany.colors.primary}15`}>
              <MapPin size={28} strokeWidth={1.75} color={activeCompany.colors.primary} />
            </div>
            <div>
              <p class="text-sm text-gray-500 mb-1">{contactTexts.addressTitle}</p>
              <p class="text-base lg:text-lg text-gray-900">{activeCompany.legalAddress}</p>
            </div>
          </div>
        </div>

        <div class="bg-white p-7 lg:p-8 rounded-2xl border border-gray-200">
          <h3 class="text-xl lg:text-2xl font-bold text-gray-900 mb-4">
            {contactTexts.workingHoursTitle}
          </h3>
          <div class="space-y-2">
            <p class="text-base lg:text-lg text-gray-700">{activeCompany.workingHours.weekdays}</p>
            <p class="text-base lg:text-lg text-gray-600">{activeCompany.workingHours.weekends}</p>
          </div>
        </div>

        <div class="bg-white p-7 lg:p-8 rounded-2xl border border-gray-200">
          <h3 class="text-xl lg:text-2xl font-bold text-gray-900 mb-5">
            {contactTexts.messengersTitle}
          </h3>
          <div class="grid grid-cols-3 gap-3">
            {messengerLinks.map((m) => {
              const IconComponent = messengerIconMap[m.icon];
              return (
                <a href={m.href} target="_blank" rel="noopener noreferrer" class="flex flex-col items-center gap-2 p-4 rounded-xl border border-gray-200 hover:bg-gray-50 hover:border-gray-300 transition-colors">
                  {IconComponent && (
                    <IconComponent size={32} strokeWidth={1.75} color={activeCompany.colors.primary} />
                  )}
                  <span class="text-sm lg:text-base font-medium text-gray-700">{m.label}</span>
                </a>
              );
            })}
          </div>
        </div>

        <div class="bg-white p-2 rounded-2xl border border-gray-200 overflow-hidden">
          <iframe src={mapEmbedUrl} width="100%" height="320" style="border:0; border-radius: 0.875rem;" allowfullscreen loading="lazy" referrerpolicy="no-referrer-when-downgrade" title={`Карта: ${activeCompany.name}`}></iframe>
        </div>

        <a 
          href={mapDirectLink}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center gap-2 px-4 py-3 bg-white rounded-xl border border-gray-200 text-base font-semibold text-gray-700 hover:bg-gray-50 hover:border-gray-300 transition-colors"
        >
          <ExternalLink size={18} strokeWidth={1.75} />
          <span>Відкрити в Google Maps</span>
        </a>

      </div>

      <div class="bg-white p-7 lg:p-9 rounded-2xl border border-gray-200">
        <h3 class="text-2xl lg:text-3xl font-bold text-gray-900 mb-2">
          {contactTexts.formTitle}
        </h3>
        <p class="text-base lg:text-lg text-gray-600 mb-6">
          {contactTexts.formSubtitle}
        </p>

        <form action={mailtoHref} method="post" enctype="text/plain" class="space-y-5">

          <div>
            <label for="name" class="block text-sm lg:text-base font-semibold text-gray-700 mb-2">
              {contactTexts.fieldNameLabel} <span class="text-red-500">*</span>
            </label>
            <input type="text" id="name" name="name" required placeholder={contactTexts.fieldNamePlaceholder} class="w-full px-4 py-3 text-base border border-gray-300 rounded-lg focus:outline-none focus:border-gray-900 transition" />
          </div>

          <div>
            <label for="phone" class="block text-sm lg:text-base font-semibold text-gray-700 mb-2">
              {contactTexts.fieldPhoneLabel} <span class="text-red-500">*</span>
            </label>
            <input type="tel" id="phone" name="phone" required placeholder={contactTexts.fieldPhonePlaceholder} class="w-full px-4 py-3 text-base border border-gray-300 rounded-lg focus:outline-none focus:border-gray-900 transition" />
          </div>

          <div>
            <label for="email" class="block text-sm lg:text-base font-semibold text-gray-700 mb-2">
              {contactTexts.fieldEmailLabel}
            </label>
            <input type="email" id="email" name="email" placeholder={contactTexts.fieldEmailPlaceholder} class="w-full px-4 py-3 text-base border border-gray-300 rounded-lg focus:outline-none focus:border-gray-900 transition" />
          </div>

          <div>
            <label for="service" class="block text-sm lg:text-base font-semibold text-gray-700 mb-2">
              {contactTexts.fieldServiceLabel}
            </label>
            <select id="service" name="service" class="w-full px-4 py-3 text-base border border-gray-300 rounded-lg focus:outline-none focus:border-gray-900 transition bg-white">
              <option value="">{contactTexts.fieldServicePlaceholder}</option>
              {serviceOptions.map((opt) => (
                <option value={opt.value}>{opt.label}</option>
              ))}
            </select>
          </div>

          <div>
            <label for="message" class="block text-sm lg:text-base font-semibold text-gray-700 mb-2">
              {contactTexts.fieldMessageLabel}
            </label>
            <textarea id="message" name="message" rows="5" placeholder={contactTexts.fieldMessagePlaceholder} class="w-full px-4 py-3 text-base border border-gray-300 rounded-lg focus:outline-none focus:border-gray-900 transition resize-none"></textarea>
          </div>

          <div class="flex items-start gap-3">
            <input type="checkbox" id="consent" name="consent" required class="mt-1 w-5 h-5 rounded border-gray-300" style={`accent-color: ${activeCompany.colors.primary}`} />
            <label for="consent" class="text-sm lg:text-base text-gray-600 cursor-pointer">
              {contactTexts.consentText}
            </label>
          </div>

          <button type="submit" class="btn-glow w-full px-6 py-4 text-white text-base lg:text-lg font-semibold rounded-lg shadow-md hover:shadow-xl active:scale-95 transition-all duration-200" style={`background-color: ${activeCompany.colors.primary}`}>
            {contactTexts.submitButton}
          </button>

          <p class="text-xs lg:text-sm text-gray-500 text-center">
            Натискаючи кнопку, ви відкриєте поштовий клієнт з підготовленим листом
          </p>
        </form>
      </div>

    </div>

  </div>
</section>