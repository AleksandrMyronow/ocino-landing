---
import { activeCompany } from '../config/companies';
import { heroContent } from '../config/hero';
import { ShieldCheck, ArrowDown } from '@lucide/astro';

const yearsLabel = `${activeCompany.yearsOnMarket} ${activeCompany.yearsOnMarket === 1 ? 'рік' : activeCompany.yearsOnMarket < 5 ? 'роки' : 'років'}`;
---

<section id="hero" class="relative overflow-hidden bg-gradient-to-br from-gray-50 via-white to-gray-50 pt-24 pb-16 lg:pt-32 lg:pb-24">

  <!-- Декоративна пляма ліворуч -->
  <div 
    class="absolute -top-24 -left-24 w-96 h-96 rounded-full opacity-20 blur-3xl pointer-events-none"
    style={`background-color: ${activeCompany.colors.primary}`}
  ></div>
  
  <!-- Декоративна пляма праворуч -->
  <div 
    class="absolute -bottom-32 -right-24 w-[28rem] h-[28rem] rounded-full opacity-15 blur-3xl pointer-events-none"
    style={`background-color: ${activeCompany.colors.primary}`}
  ></div>

  <!-- Центральний контейнер -->
  <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">

    <!-- Бейдж зверху -->
    <div 
      class="inline-flex items-center gap-2 px-4 py-2 rounded-full mb-8"
      style={`background-color: ${activeCompany.colors.primary}15; color: ${activeCompany.colors.primary}`}
    >
      <ShieldCheck size={18} strokeWidth={2} />
      <span class="text-sm font-semibold">{heroContent.badge}</span>
    </div>

    <!-- Великий заголовок -->
    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-gray-900 mb-6 leading-tight">
      {heroContent.titlePart1}
      <br/>
      <span style={`color: ${activeCompany.colors.primary}`}>
        {heroContent.titlePart2}
      </span>
    </h1>

    <!-- Підзаголовок -->
    <p class="text-lg sm:text-xl text-gray-600 max-w-3xl mx-auto mb-10 leading-relaxed">
      {heroContent.subtitle}
    </p>

    <!-- CTA кнопки -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-10">
      
      <a 
        href={heroContent.primaryCTA.href}
        class="inline-flex items-center justify-center px-8 py-4 text-base font-semibold text-white rounded-xl hover:opacity-90 transition-opacity shadow-lg hover:shadow-xl"
        style={`background-color: ${activeCompany.colors.primary}`}
      >
        {heroContent.primaryCTA.text}
      </a>

      <a 
        href={heroContent.secondaryCTA.href}
        class="inline-flex items-center justify-center px-8 py-4 text-base font-semibold text-gray-700 bg-white border-2 border-gray-200 rounded-xl hover:border-gray-400 hover:bg-gray-50 transition-all"
      >
        {heroContent.secondaryCTA.text}
      </a>
    </div>

    <!-- Тонкий trust-рядок -->
    <div class="flex flex-wrap items-center justify-center gap-x-3 gap-y-2 text-xs sm:text-sm text-gray-500">
      <span>
        <span class="font-semibold text-gray-700">{yearsLabel}</span> 
        {heroContent.trustItems[0]}
      </span>
      <span class="text-gray-300">·</span>
      <span>{heroContent.trustItems[1]}</span>
      <span class="text-gray-300">·</span>
      <span>{heroContent.trustItems[2]}</span>
      <span class="text-gray-300">·</span>
      <span>{heroContent.trustItems[3]}</span>
      <span class="text-gray-300">·</span>
      <span>{heroContent.trustItems[4]}</span>
    </div>

  </div>

  <!-- Скрол-індикатор -->
  <div class="absolute bottom-6 left-1/2 -translate-x-1/2 hidden md:block">
    <a 
      href="#services" 
      class="flex flex-col items-center gap-2 text-gray-400 hover:text-gray-600 transition-colors"
      aria-label="Прокрутити вниз"
    >
      <span class="text-xs uppercase tracking-wider">Дізнатись більше</span>
      <ArrowDown size={20} strokeWidth={1.5} class="animate-bounce" />
    </a>
  </div>

</section>