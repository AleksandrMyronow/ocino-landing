---
import { activeCompany } from '../config/companies';
---

<header class="bg-white border-b border-gray-200 sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">

      <!-- Логотип -->
      <a href="/" class="flex items-center">
        <img 
          src={activeCompany.logo} 
          alt={activeCompany.name}
          class="h-12 w-auto"
        />
      </a>

      <!-- Навігація (desktop) -->
      <nav class="hidden md:flex items-center gap-8">
        <a href="#about" class="text-gray-700 hover:text-gray-900 font-medium">Про нас</a>
        <a href="#services" class="text-gray-700 hover:text-gray-900 font-medium">Послуги</a>
        <a href="#documents" class="text-gray-700 hover:text-gray-900 font-medium">Документи</a>
        <a href="#pricing" class="text-gray-700 hover:text-gray-900 font-medium">Вартість</a>
        <a href="#contact" class="text-gray-700 hover:text-gray-900 font-medium">Контакти</a>
      </nav>

      <!-- Телефон + CTA -->
      <div class="flex items-center gap-4">
        <a 
          href={`tel:${activeCompany.phoneRaw}`}
          class="hidden sm:block font-semibold text-gray-900 hover:underline"
        >
          {activeCompany.phone}
        </a>
        <a 
          href="#contact"
          class="px-5 py-2.5 rounded-lg text-white font-semibold text-sm transition-opacity hover:opacity-90"
          style={`background-color: ${activeCompany.colors.primary}`}
        >
          Замовити оцінку
        </a>
      </div>

    </div>
  </div>
</header>