---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import { activeCompany } from '../config/companies';
---

<Layout 
  title={`${activeCompany.name} — Незалежна експертна оцінка майна`}
  description={`${activeCompany.name} — професійні послуги з оцінки нерухомості, землі, транспорту, бізнесу. ${activeCompany.address}`}
>
  <Header />
  <Hero />
  <Services />
</Layout>
